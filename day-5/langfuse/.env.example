# ==============================================================================
# Langfuse Local Docker Environment Configuration
# ==============================================================================

# Core Application Settings
NEXTAUTH_URL=http://localhost:3000
TELEMETRY_ENABLED=false

# Secrets (Pre-generated securely for local use)
# NEXTAUTH_SECRET & SALT can be generated via: openssl rand -base64 32
NEXTAUTH_SECRET=-1wdNxXZBsRg50tg3T6fuZEPUqHzDpijg5wH_-vi80M
SALT=0c3723aafb4eb829d4d4f7b690612136

# Must be 256 bits (64 hex characters)
# Generate via: openssl rand -hex 32
ENCRYPTION_KEY=c3e66afea7a8aa23defbc95da5952fe2ecca7f14884092d6c081000ab8f79b38

# ==============================================================================
# Database Credentials
# ==============================================================================

# PostgreSQL
POSTGRES_USER=postgres
POSTGRES_PASSWORD=postgres
POSTGRES_DB=postgres
DATABASE_URL=postgresql://postgres:postgres@postgres:5432/postgres

# ClickHouse
CLICKHOUSE_USER=clickhouse
CLICKHOUSE_PASSWORD=637bb7d3e6aba024aa981a62
CLICKHOUSE_URL=http://clickhouse:8123
CLICKHOUSE_MIGRATION_URL=clickhouse://clickhouse:9000
CLICKHOUSE_CLUSTER_ENABLED=false

# Redis
REDIS_HOST=redis
REDIS_PORT=6379
REDIS_AUTH=353b289bb501db76dd0c0254

# MinIO (S3 compatible storage)
MINIO_ROOT_USER=minio
MINIO_ROOT_PASSWORD=504c4af5ce17281dfdc7621d

# ==============================================================================
# Headless Initial Setup (Optional: Auto-creates user, project & API keys)
# Comment these out if you prefer to register manually via the web UI.
# ==============================================================================
LANGFUSE_INIT_ORG_ID=local-org
LANGFUSE_INIT_ORG_NAME=Local Organization
LANGFUSE_INIT_PROJECT_ID=local-project
LANGFUSE_INIT_PROJECT_NAME=Local Project
LANGFUSE_INIT_PROJECT_PUBLIC_KEY=pk-lf-local-demo-1234567890
LANGFUSE_INIT_PROJECT_SECRET_KEY=sk-lf-local-demo-1234567890
LANGFUSE_INIT_USER_EMAIL=admin@langfuse.local
LANGFUSE_INIT_USER_NAME=Admin
LANGFUSE_INIT_USER_PASSWORD=adminpassword123
